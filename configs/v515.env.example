# Copy this file to configs/v515.env and edit paths for your own machine.
# Do not commit configs/v515.env; it contains machine-specific paths.

# Linux kernel 5.15 source/build directory (in-tree build in this project).
KERNEL_DIR="/home/cengin/linux"

# Debian Trixie QEMU image directory created by syzkaller's create-image.sh.
IMAGE_DIR="/home/cengin/linux/image"

# SyzMini repository's inner syzkaller source directory.
SYZKALLER_DIR="/home/cengin/SyzMini/syzmini"

# Influence matrix generated for the exact target syscall table.
INFLUENCE_FILE="/home/cengin/SyzMini/influencev5.15.txt"

# Runtime settings. Keep them unchanged between comparable runs.
HTTP_ADDR="127.0.0.1:56741"
PROCS="8"
VM_COUNT="4"
VM_CPU="2"
VM_MEM="2048"

# Optional: set a unique run label, e.g. syzmini-r1.
RUN_ID=""
